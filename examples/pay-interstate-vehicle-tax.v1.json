        "locators": [
          {
            "kind": "label",
            "text": "Password"
          },
          {
            "kind": "css",
            "selector": "#password"
          }
        ],
        "anchor": {
          "bbox": [
            439.0,
            332.0,
            799.0,
            367.0
          ]
        }
      },
      "value": "{{portal_password}}"
    },
    {
      "id": "s04",
      "intent": "Click Sign in to log in",
      "action": "click",
      "target": {
        "description": "Dark blue rectangular button labeled Sign in below password field",
        "noun_phrase": "blue Sign in button",
        "locators": [
          {
            "kind": "role",
            "role": "button",
            "name": "Sign in"
          },
          {
            "kind": "css",
            "selector": "#login_btn"
          }
        ],
        "anchor": {
          "bbox": [
            439.0,
            381.0,
            529.0,
            418.0
