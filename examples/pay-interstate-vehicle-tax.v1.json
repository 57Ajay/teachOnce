  "source_recording": "rec_20261028_220743",
  "variables": [
    {
      "name": "vehicle_registration_number",
      "column": "vehicle_no",
      "example": "NV07AB1234",
      "description": "Vehicle registration number"
    },
    {
      "name": "owner_name",
      "column": "owner_name",
      "example": "Asha Verma",
      "description": "Owner name"
    },
    {
      "name": "vehicle_type",
      "column": "vehicle_type",
      "example": "Bus",
      "description": "Vehicle type"
    },
    {
      "name": "from_state",
      "column": "from_state",
      "example": "Northvale",
      "description": "Origin (from) state"
    },
    {
      "name": "to_state",
      "column": "to_state",
      "example": "Westholm",
      "description": "Destination (to) state"
    },
    {
      "name": "entry_date",
      "column": "entry_date",
      "example": "2026-11-03",
      "description": "Entry date"
    },
    {
      "name": "tax_period",
      "column": "tax_period",
      "example": "7 days",
      "description": "Tax period"
    },
    {
      "name": "mobile_number",
      "column": "mobile",
      "example": "9876543210",
      "description": "Mobile number"
