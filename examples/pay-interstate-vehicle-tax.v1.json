    {
      "id": "s02",
      "intent": "Enter the operator username",
      "action": "fill",
      "target": {
        "description": "First text input in centered Sign in card labeled Username with red asterisk",
        "noun_phrase": "username text field",
        "locators": [
          {
            "kind": "role",
            "role": "textbox",
            "name": "Username"
          },
          {
            "kind": "label",
            "text": "Username"
          },
          {
            "kind": "css",
            "selector": "#username"
          }
        ],
        "anchor": {
          "bbox": [
            439.0,
            261.0,
            799.0,
            296.0
          ]
        }
      },
      "value": "operator",
      "check": {
        "kind": "value_equals"
      }
    },
    {
      "id": "s03",
      "intent": "Enter the operator password",
      "action": "fill",
      "target": {
        "description": "Second input in Sign in card labeled Password with asterisk below Username field",
