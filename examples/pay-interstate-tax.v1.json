{
  "id": "pay-interstate-tax",
  "version": 1,
  "name": "Pay interstate vehicle tax",
  "start_url": "{{PORTAL_URL}}/portal/login",
  "source_recording": "hand-written",
  "variables": [
    {
      "name": "vehicle_no",
      "column": "vehicle_no",
      "example": "NV07AB1234",
      "description": "Vehicle registration number"
    },
    {
      "name": "owner_name",
      "column": "owner_name",
      "example": "Asha Verma",
      "description": "Registered owner's name"
    },
    {
      "name": "vehicle_type",
      "column": "vehicle_type",
      "example": "Bus",
      "description": "Car, Taxi, Bus or Goods"
    },
    {
      "name": "from_state",
      "column": "from_state",
      "example": "Northvale",
      "description": "State the vehicle comes from"
    },
    {
      "name": "to_state",
      "column": "to_state",
      "example": "Westholm",
      "description": "Destination state"
    },
    {
      "name": "entry_date",
      "column": "entry_date",
      "example": "2026-11-03",
      "description": "Entry date, YYYY-MM-DD"
    },
    {
      "name": "tax_period",
      "column": "tax_period",
      "example": "7 days",
      "description": "1 day, 7 days or 30 days"
    },
    {
      "name": "mobile",
      "column": "mobile",
      "example": "9876543210",
      "description": "10-digit mobile number"
    }
  ],
  "secrets": [
    {
      "name": "portal_password",
      "env": "PORTAL_PASSWORD"
    }
  ],
  "steps": [
    {
      "id": "s01",
      "intent": "Open the portal sign-in page",
      "action": "goto",
      "value": "{{PORTAL_URL}}/portal/login",
      "check": {
        "kind": "url_contains",
        "value": "/portal/login"
      }
    },
    {
      "id": "s02",
      "intent": "Enter the username",
      "action": "fill",
      "target": {
        "description": "Username text field on the sign-in form",
        "noun_phrase": "username text field",
        "locators": [
          {
            "kind": "role",
            "role": "textbox",
            "name": "Username"
          },
          {
            "kind": "label",
            "text": "Username"
          },
          {
            "kind": "css",
            "selector": "#username"
          }
        ]
      },
      "value": "operator",
      "check": {
        "kind": "value_equals"
      }
    },
    {
      "id": "s03",
      "intent": "Enter the password",
      "action": "fill",
      "target": {
        "description": "Password field on the sign-in form",
        "noun_phrase": "password field",
        "locators": [
          {
            "kind": "label",
            "text": "Password"
          },
          {
            "kind": "css",
            "selector": "#password"
          }
        ]
      },
      "value": "{{portal_password}}"
    },
    {
      "id": "s04",
      "intent": "Sign in",
      "action": "click",
      "target": {
        "description": "Sign in button below the password field",
        "noun_phrase": "sign in button",
        "locators": [
          {
            "kind": "role",
            "role": "button",
            "name": "Sign in"
          },
          {
            "kind": "css",
            "selector": "#login_btn"
          }
        ]
      },
      "check": {
        "kind": "url_contains",
        "value": "/portal/dashboard"
      }
    },
    {
      "id": "s05",
      "intent": "Open the interstate vehicle tax service",
      "action": "click",
      "target": {
        "description": "Pay Interstate Vehicle Tax tile on the dashboard",
        "noun_phrase": "pay interstate vehicle tax tile",
        "locators": [
          {
            "kind": "role",
            "role": "link",
            "name": "Pay Interstate Vehicle Tax"
          },
          {
            "kind": "css",
            "selector": "#tile_tax"
          }
        ]
      },
      "check": {
        "kind": "url_contains",
        "value": "/portal/tax/new"
      }
    },
    {
      "id": "s06",
      "intent": "Enter the vehicle registration number",
      "action": "fill",
      "target": {
        "description": "Vehicle registration number text input in Vehicle details",
        "noun_phrase": "vehicle number text field",
        "locators": [
          {
            "kind": "role",
            "role": "textbox",
            "name": "Vehicle registration number"
          },
          {
            "kind": "label",
            "text": "Vehicle registration number"
          },
          {
            "kind": "placeholder",
            "text": "e.g. NV07AB1234"
          },
          {
            "kind": "css",
            "selector": "#veh_no"
          }
        ]
      },
      "value": "{{vehicle_no}}",
      "check": {
        "kind": "value_equals"
      }
    },
    {
      "id": "s07",
      "intent": "Enter the owner name",
      "action": "fill",
      "target": {
        "description": "Owner name text input in Vehicle details",
        "noun_phrase": "owner name text field",
        "locators": [
          {
            "kind": "role",
            "role": "textbox",
            "name": "Owner name"
          },
          {
            "kind": "label",
            "text": "Owner name"
          },
          {
            "kind": "css",
            "selector": "#owner_name"
          }
        ]
      },
      "value": "{{owner_name}}",
      "check": {
        "kind": "value_equals"
      }
    },
    {
      "id": "s08",
      "intent": "Choose the vehicle type",
      "action": "select",
      "target": {
        "description": "Vehicle type dropdown in Vehicle details",
        "noun_phrase": "vehicle type dropdown",
        "locators": [
          {
            "kind": "role",
            "role": "combobox",
            "name": "Vehicle type"
          },
          {
            "kind": "label",
            "text": "Vehicle type"
          },
          {
            "kind": "css",
            "selector": "#vehicle_type"
          }
        ]
      },
      "value": "{{vehicle_type}}",
      "check": {
        "kind": "value_equals"
      }
    },
    {
      "id": "s09",
      "intent": "Choose the state of origin",
      "action": "select",
      "target": {
        "description": "From state dropdown in Journey details",
        "noun_phrase": "from state dropdown",
        "locators": [
          {
            "kind": "role",
            "role": "combobox",
            "name": "From state"
          },
          {
            "kind": "label",
            "text": "From state"
          },
          {
            "kind": "css",
            "selector": "#from_state"
          }
        ]
      },
      "value": "{{from_state}}",
      "check": {
        "kind": "value_equals"
      }
    },
    {
      "id": "s10",
      "intent": "Choose the destination state",
      "action": "select",
      "target": {
        "description": "To state dropdown in Journey details",
        "noun_phrase": "to state dropdown",
        "locators": [
          {
            "kind": "role",
            "role": "combobox",
            "name": "To state"
          },
          {
            "kind": "label",
            "text": "To state"
          },
          {
            "kind": "css",
            "selector": "#to_state"
          }
        ]
      },
      "value": "{{to_state}}",
      "check": {
        "kind": "value_equals"
      }
    },
    {
      "id": "s11",
      "intent": "Enter the entry date",
      "action": "fill_date",
      "target": {
        "description": "Entry date picker in Journey details",
        "noun_phrase": "entry date input field",
        "locators": [
          {
            "kind": "label",
            "text": "Entry date"
          },
          {
            "kind": "css",
            "selector": "#entry_date"
          }
        ]
      },
      "value": "{{entry_date}}",
      "check": {
        "kind": "value_equals"
      }
    },
    {
      "id": "s12",
      "intent": "Choose the tax period",
      "action": "check",
      "target": {
        "description": "Tax period radio button matching the row's period",
        "noun_phrase": "tax period radio button",
        "locators": [
          {
            "kind": "role",
            "role": "radio",
            "name": "{{tax_period}}"
          },
          {
            "kind": "label",
            "text": "{{tax_period}}"
          }
        ]
      }
    },
    {
      "id": "s13",
      "intent": "Enter the mobile number",
      "action": "fill",
      "target": {
        "description": "Mobile number text input in Contact details",
        "noun_phrase": "mobile number text field",
        "locators": [
          {
            "kind": "role",
            "role": "textbox",
            "name": "Mobile number"
          },
          {
            "kind": "label",
            "text": "Mobile number"
          },
          {
            "kind": "placeholder",
            "text": "10-digit number"
          },
          {
            "kind": "css",
            "selector": "#mobile"
          }
        ]
      },
      "value": "{{mobile}}",
      "check": {
        "kind": "value_equals"
      }
    },
    {
      "id": "s14",
      "intent": "Accept the declaration",
      "action": "check",
      "target": {
        "description": "Declaration checkbox above the submit button",
        "noun_phrase": "declaration checkbox",
        "locators": [
          {
            "kind": "role",
            "role": "checkbox",
            "name": "I declare that the above details are correct."
          },
          {
            "kind": "css",
            "selector": "#declaration"
          }
        ]
      }
    },
    {
      "id": "s15",
      "intent": "Calculate the tax",
      "action": "click",
      "target": {
        "description": "Calculate Tax button at the bottom of the form",
        "noun_phrase": "calculate tax button",
        "locators": [
          {
            "kind": "role",
            "role": "button",
            "name": "Calculate Tax"
          },
          {
            "kind": "css",
            "selector": "#calc_btn"
          }
        ]
      },
      "check": {
        "kind": "url_contains",
        "value": "/portal/tax/review"
      }
    },
    {
      "id": "s16",
      "intent": "Proceed to payment",
      "action": "click",
      "target": {
        "description": "Proceed to Pay button on the review page",
        "noun_phrase": "proceed to pay button",
        "locators": [
          {
            "kind": "role",
            "role": "link",
            "name": "Proceed to Pay"
          },
          {
            "kind": "css",
            "selector": "#proceed_btn"
          }
        ]
      },
      "check": {
        "kind": "url_contains",
        "value": "/portal/tax/pay"
      }
    },
    {
      "id": "s17",
      "intent": "Pay",
      "action": "click",
      "target": {
        "description": "Pay Now (Demo) button on the payment page",
        "noun_phrase": "pay now button",
        "locators": [
          {
            "kind": "role",
            "role": "button",
            "name": "Pay Now (Demo)"
          },
          {
            "kind": "css",
            "selector": "#pay_btn"
          }
        ]
      },
      "check": {
        "kind": "url_contains",
        "value": "/portal/tax/receipt/"
      }
    },
    {
      "id": "s18",
      "intent": "Read the receipt number",
      "action": "extract",
      "output": "receipt_no",
      "pattern": "DTP-\\d{4}-\\d{6}",
      "target": {
        "description": "Receipt No. row in the receipt details table",
        "noun_phrase": "receipt number row",
        "locators": [
          {
            "kind": "role",
            "role": "row",
            "name": "Receipt No."
          },
          {
            "kind": "css",
            "selector": "#receipt_no"
          }
        ]
      }
    }
  ]
}
