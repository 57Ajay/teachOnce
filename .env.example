META_API_KEY=
MAX_SPEND_USD=100
# off | record | replay
META_CACHE=off
# optional: a Chromium binary to use instead of Playwright's own (leave empty normally)
CHROMIUM_PATH=
# demo portal login (the runner falls back to these; exported scripts read them from the environment)
PORTAL_USER=operator
PORTAL_PASSWORD=demo123
# passwords typed while teaching on other sites: one per site, named by teach_live.py
# (the local OrangeHRM from orangehrm_local.py; the shared public demo would be ORANGEHRMLIVE_PASSWORD=admin123)
LOCALHOST_8200_PASSWORD=Teach@Once1
